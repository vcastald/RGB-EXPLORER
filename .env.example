# Copy to .env. These are local development defaults; do not put wallet secrets here.
API_PORT=3101
WEB_PORT=5173
# Local SQLite files (relative to repo root); one database per developer.
APP_DB_PATH=.local-app/addresses.sqlite
PARAMS_DB_PATH=.local-app/params.sqlite
RGB_NODE_HOST=127.0.0.1
RGB_NODE_PORT=3901
RGB_PEER_PORT=10091
# Optional: set this if your node is hosted elsewhere instead of using RGB_NODE_HOST:RGB_NODE_PORT.
# RGB_NODE_URL=http://127.0.0.1:3901

# USDT-only LSP; independent of the BTC/market provider.
USDT_LSP_URL=https://api.mutinynet2.kaleidoswap.com
# On-chain RGB invoice consignment transport (server-controlled, not caller supplied).
RGB_PROXY_ENDPOINT=rpcs://proxy.iriswallet.com/0.2/json-rpc
KALEIDO_API_URL=https://api.mutinynet2.kaleidoswap.com