# Copy to .env. These are local development defaults; do not put wallet secrets here.
API_PORT=3101
WEB_PORT=5173
# Local SQLite file (relative to repo root); one database per developer.
APP_DB_PATH=.local-app/addresses.sqlite
RGB_NODE_HOST=127.0.0.1
RGB_NODE_PORT=3901
RGB_PEER_PORT=10091
# Optional: set this if your node is hosted elsewhere instead of using RGB_NODE_HOST:RGB_NODE_PORT.
# RGB_NODE_URL=http://127.0.0.1:3901
